node_modules/
dist/
build/
.env
.env.local
# Sır içeren tüm .env türevleri (.env.dump gibi) — örnek dosyalar hariç
.env.*
!.env.*.example
# Anahtar adını taşıyan dosyalar kök dizinde kazara oluşabiliyor (kabuk
# yönlendirmesi: `... > service_role`). Adı bir sırrı çağrıştırdığı için,
# ileride aynı ada DOLU bir dosya oluşursa commit'e girmesin.
/service_role
/anon_key
*.log
.expo/
.DS_Store
coverage/
deploy/__pycache__/
*.pyc

# Yedek ve otomatik üretilen geçici dosyalar
*.bak
# Canlı veritabanından üretilen geçici şema çıktıları
deploy/canli-sema*.sql
deploy/canli-*.dump
deploy/canli-*.sql.gz
deploy/canli-cron.*
# Veritabanı yedekleri — ASLA commit edilmemeli (şifre hash'leri, Drive jetonları)
yedek/
*.sql.gz
vite.config.ts.timestamp-*.mjs

# Silinmek uzere kenara alinan dosyalar (bkz. sohbet notu) — repoya girmemeli
_to_delete/

# FUSE tabanli baglama noktalarinda acik dosya tutamaklari icin uretilen artiklar
.fuse_hidden*

# Next.js tanıtım sitesi (landing/). landing/.gitignore de aynı kuralları
# taşıyor; buradakiler yedek: o dosya silinir ya da kök dizinden bir derleme
# çalıştırılırsa 450 MB'lık çıktı sessizce repoya girer.
.next/
out/
.vercel/
*.tsbuildinfo

# Claude Code kişisel ayarları (izin kuralları) — paylaşılmaz
.claude/settings.local.json

# Claude Code'un yerel çalışma dosyaları: worktrees geçici git kopyaları
# (her biri repo boyutunda), launch.json ise dev sunucusunu tarayıcı
# panelinde açmak için makineye özel bir kısayol. İkisi de paylaşılmaz.
.claude/worktrees/
.claude/launch.json

# Uygulama dışı çıktılar (mağaza görselleri, üretilen paketler). Repoda
# durmalarının bir sebebi yok ve yayın betiği bunları "commit'lenmemiş
# değişiklik" sayıp yayını durduruyor.
output/

# --- Mobil kabuk (Capacitor) ---
# android/ ve ios/ klasörleri `cap add` ile ÜRETİLİYOR ama repoda DURUYOR:
# içlerinde elle yapılan ayarlar var (paket kimliği, izinler, App Links, imza
# yapılandırması). Üretilen derleme çıktıları ise girmemeli.
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/src/main/assets/public/
apps/mobile/android/app/src/main/assets/capacitor.config.json
apps/mobile/android/app/src/main/assets/capacitor.plugins.json
apps/mobile/ios/App/App/public/
apps/mobile/ios/App/Pods/
