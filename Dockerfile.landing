FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY landing/package.json landing/package-lock.json ./
RUN npm ci

COPY landing/ ./

ARG NEXT_PUBLIC_SITE_URL=http://193.111.77.252:3001
ARG NEXT_PUBLIC_APP_URL=http://193.111.77.252
ARG NEXT_PUBLIC_WHATSAPP=
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL} \
    NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL} \
    NEXT_PUBLIC_WHATSAPP=${NEXT_PUBLIC_WHATSAPP}

RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0

WORKDIR /app
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

# ISR ÖNBELLEĞİ İÇİN YAZILABİLİR KLASÖR. Kopyalanan dosyalar root'a ait, süreç
# ise "node" kullanıcısıyla koşuyor: Next /app/.next/cache'i açamayınca her
# istekte EACCES alıyor ve revalidate ÇALIŞMIYOR. Sonuç: sayfalar imaj
# derlenirken alınan kopyada donuyordu — fiyatlar panelde değişse de tanıtım
# sitesi eski rakamı göstermeye devam ediyordu (2026-09-20'de yakalandı).
RUN mkdir -p /app/.next/cache && chown -R node:node /app/.next

USER node
EXPOSE 3001
CMD ["node", "server.js"]
