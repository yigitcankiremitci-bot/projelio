FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci
COPY apps/web apps/web
COPY packages/shared packages/shared
ARG VITE_API_URL
ARG VITE_GOOGLE_PICKER_API_KEY
ARG VITE_GOOGLE_PICKER_APP_ID
ARG VITE_HABIE_URL
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GOOGLE_PICKER_API_KEY=${VITE_GOOGLE_PICKER_API_KEY}
ENV VITE_GOOGLE_PICKER_APP_ID=${VITE_GOOGLE_PICKER_APP_ID}
ENV VITE_HABIE_URL=${VITE_HABIE_URL}
RUN npm run build --workspace=@projelio/web

# Sıkıştırma çalışma anında değil BURADA yapılıyor — gerekçesi betiğin başında.
COPY deploy/onsikistir.mjs deploy/onsikistir.mjs
RUN node deploy/onsikistir.mjs apps/web/dist

FROM caddy:2.11.4-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv/web
