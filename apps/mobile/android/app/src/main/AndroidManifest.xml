<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              GOOGLE / MICROSOFT İLE GİRİŞİN DÖNÜŞ YOLU.

              Google gömülü WebView'da giriş sayfasını açmayı reddediyor
              (disallowed_useragent), bu yüzden adres sistem tarayıcısında
              açılıyor. Zincirin sonunda backend
              https://app.projelio.app/google/return?code=... adresine
              yönlendiriyor; bu filtre sayesinde Android o adresi tarayıcıda
              açmak yerine uygulamaya teslim ediyor.

              autoVerify: Android, https://app.projelio.app/.well-known/assetlinks.json
              dosyasını indirip uygulamanın imza parmak izini orada arıyor;
              eşleşmezse filtre çalışmaz ve adres sessizce tarayıcıda açılır.
              Parmak izleri o dosyada — Play'e yükledikten sonra Play App
              Signing'in parmak izi de EKLENMELİ (bkz. docs/mobil-app-links.md).

              YALNIZCA İKİ YOL: alan adının tamamı talep edilirse siteye giden
              her bağlantı uygulamayı açardı (ör. e-postadaki şifre sıfırlama
              bağlantısı), ki istenen bu değil.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.projelio.app" android:path="/google/return" />
                <data android:scheme="https" android:host="app.projelio.app" android:path="/microsoft/return" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
