<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <!--
              KLAVYE: adjustResize ŞART. Belirtilmediğinde Android pencereyi
              klavyenin boyu kadar YUKARI İTİYORDU (pan): üstteki sabit şerit
              dahil bütün sayfa ekrandan çıkıyor, yazılan kutu da çoğu zaman
              görünmüyordu. Edge-to-edge modda adjustResize pencereyi kendisi
              küçültmez; yalnızca kaydırmayı durdurup klavye payını (IME
              inset) uygulamaya bırakır. O payı safe-area eklentisi WebView'e
              alt dolgu olarak veriyor → görünür alan klavyenin üstünde biter,
              position:fixed öğeler yerinde kalır.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              GOOGLE / MICROSOFT İLE GİRİŞİN DÖNÜŞ YOLU.

              Google gömülü WebView'da giriş sayfasını açmayı reddediyor
              (disallowed_useragent), bu yüzden adres sistem tarayıcısında
              açılıyor. Zincirin sonunda backend
              https://app.projelio.app/google/return?code=... adresine
              yönlendiriyor; bu filtre sayesinde Android o adresi tarayıcıda
              açmak yerine uygulamaya teslim ediyor.

              autoVerify: Android, https://app.projelio.app/.well-known/assetlinks.json
              dosyasını indirip uygulamanın imza parmak izini orada arıyor;
              eşleşmezse filtre çalışmaz ve adres sessizce tarayıcıda açılır.
              Parmak izleri o dosyada — Play'e yükledikten sonra Play App
              Signing'in parmak izi de EKLENMELİ (bkz. docs/mobil-app-links.md).

              YALNIZCA İKİ YOL: alan adının tamamı talep edilirse siteye giden
              her bağlantı uygulamayı açardı (ör. e-postadaki şifre sıfırlama
              bağlantısı), ki istenen bu değil.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.projelio.app" android:path="/google/return" />
                <data android:scheme="https" android:host="app.projelio.app" android:path="/microsoft/return" />
            </intent-filter>
        </activity>

        <!--
          BİLDİRİMLER (FCM). Uygulama arka plandayken ya da kapalıyken bildirimi
          Android'in kendisi çizer ve bu üç değeri buradan okur; kodla
          ayarlanamazlar.

          İkon: yalnızca alfa kanalı kullanılır; uygulama ikonu verilirse
          bildirimde düz beyaz bir kare görünür (bkz. scripts/bildirim-ikonu-uret.py).
          Kanal: Android 8+ kanalsız bildirimi "Diğer" adlı sessiz bir kanala
          düşürür. Kanal MainActivity'de oluşturuluyor; sunucu da aynı kimliği
          gönderiyor (backend fcm.ts BILDIRIM_KANALI).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_projelio" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/projelioAccent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/bildirim_kanali_kimligi" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 13+ bildirim izni. Beyan edilmezse izin penceresi HİÇ çıkmaz ve
      bildirimler sessizce engellenir — 1.1.0'da tam olarak bu oldu. İzin
      giriş yapıldıktan sonra web tarafından istenir (lib/mobilKabuk.ts).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
