VITE_API_URL=http://localhost:3000

# NOT: Frontend Supabase'e doğrudan bağlanmaz — tüm veri erişimi backend
# (VITE_API_URL / EXPO_PUBLIC_API_URL) üzerinden geçer. Bu yüzden burada
# Supabase URL'i veya anahtarı TUTULMAZ. Buraya bir Supabase anahtarı eklemeyin:
# bu dosyadaki her değer tarayıcıya/uygulamaya gömülü olarak dağıtılır.

# --- Google Drive "Drive'dan seç" (Picker) -----------------------------------
# Bu ikisi olmadan Dosyalar > "Drive'dan seç" düğmesi hata verir. Drive'a dosya
# YÜKLEMEK bunlara ihtiyaç duymaz — Picker tarayıcıda çalışan ayrı bir widget ve
# Google'ın kendi sunucusuna doğrudan gider, backend'e uğramaz. O yüzden
# backend'deki GOOGLE_CLIENT_ID/SECRET yetmiyor.
# Alma adımları: docs/google-drive-kurulum.md > "Drive'dan seç (Picker)".
#
# Tarayıcı jetonu (kısıtlanmış API anahtarı). Gizli değildir; kısıtlaması
# Google Cloud'da "HTTP referrer" + "yalnızca Google Picker API" ile yapılır.
VITE_GOOGLE_PICKER_API_KEY=
# Google Cloud proje NUMARASI (proje kimliği değil). Picker, seçilen dosyaya
# kalıcı erişimi bu numara üzerinden veriyor; boş bırakılırsa kullanıcı dosyayı
# seçebiliyor ama uygulama sonrasında o dosyayı okuyamıyor.
VITE_GOOGLE_PICKER_APP_ID=
