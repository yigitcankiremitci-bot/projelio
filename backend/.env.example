PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/projelio
JWT_SECRET=change-me
# Üretimde frontend'in alan adı(ları). Boş bırakılırsa CORS herkese açık olur —
# yalnızca yerel geliştirmede boş bırakın.
# Örn: CORS_ORIGINS=https://projelio.netlify.app
CORS_ORIGINS=
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=  # `node -e "console.log(require('web-push').generateVAPIDKeys())"` ile üretin
VAPID_PRIVATE_KEY=
SUPABASE_URL=https://kjglfieqodfwkkfzrrtq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Supabase Dashboard > Project Settings > API'den alın (gizli tutun)
S3_BUCKET=
# AI asistanı (chatbot) için gerekli — console.anthropic.com üzerinden alın
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Projelio AI kredi ekonomisi ---
# Projelio, Anthropic'ten token maliyetiyle hizmet alır ve kullanıcıya komisyon
# ekleyerek "Projelio Kredisi" olarak satar.
AI_COMMISSION_RATE=0.2          # 0.2 = %20 komisyon
AI_CREDIT_UNIT_USD=0.0001       # 1 kredinin USD karşılığı => 10.000 kredi ≈ 1 USD
AI_MIN_BALANCE_TO_START=20      # Yeni istek için gereken asgari bakiye
AI_WELCOME_CREDITS=2000         # Yeni kullanıcıya bir defalık deneme kredisi (0 = kapalı)

# --- Maliyet sınırlayıcıları (her biri doğrudan token harcamasını etkiler) ---
AI_PROMPT_CACHING=true          # Araç şemaları + statik promptu önbelleğe al (%90 ucuz okuma)
AI_MAX_TOKENS=800               # Tek yanıtta üretilebilecek azami token
AI_MAX_TOOL_ITERATIONS=4        # Bir istekteki azami araç turu (her tur = 1 API çağrısı)
AI_MAX_TOOL_RESULT_CHARS=2500   # Araç sonuçlarının azami uzunluğu
AI_HISTORY_WINDOW=8             # Modele geri beslenen geçmiş mesaj sayısı

# Anthropic fiyat değiştirirse kod değiştirmeden güncellemek için (opsiyonel):
# AI_PRICE_OVERRIDE={"claude-haiku-4-5-20251001":{"inputPerMillion":1,"outputPerMillion":5}}

# --- E-posta gönderimi (şifre sıfırlama) ---
# resend.com > API Keys üzerinden alın. Tanımlı değilse e-posta gönderilmez;
# sıfırlama bağlantısı yalnızca sunucu loguna yazılır (yerel geliştirme için yeterli).
RESEND_API_KEY=
# Gönderen adresi. Alan adı Resend'de doğrulanmış olmalı, aksi halde gönderim reddedilir.
# Doğrulama yapılmadan denemek için Resend'in test adresi kullanılabilir:
#   EMAIL_FROM=Projelio <onboarding@resend.dev>   (yalnızca kendi hesabınızın e-postasına gönderir)
EMAIL_FROM=Projelio <destek@projelio.app>

# --- Google ile giriş + Google Drive dosya depolama ---
# 1) console.cloud.google.com > yeni proje > "Google Drive API" ve "Google Picker API"yi etkinleştirin
# 2) APIs & Services > Credentials > OAuth client ID > Web application
#    Authorized redirect URI olarak aşağıdaki GOOGLE_REDIRECT_URI'yi ekleyin
# 3) OAuth consent screen > yayın durumunu "In production" yapın.
#    "Testing" modunda Google refresh token'ları 7 GÜN sonra iptal eder ve
#    kullanıcılar her hafta yeniden bağlanmak zorunda kalır.
#    Kullandığımız drive.file scope'u "non-sensitive" olduğu için CASA güvenlik
#    denetimi gerekmez; yalnızca marka doğrulaması istenir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google'ın geri döneceği adres. Google Cloud Console'daki değerle BİREBİR aynı olmalı.
# Yerel: http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth akışı bitince kullanıcının döneceği ön yüz adresi (Vite dev sunucusu / Netlify).
WEB_APP_URL=http://localhost:5173

# Refresh token'ların şifrelenmesinde kullanılır (AES-256-GCM).
# Üretin:  openssl rand -base64 32
# Bu anahtar kaybolursa tüm kullanıcıların Drive bağlantısı kopar ve yeniden
# bağlanmaları gerekir. Anahtarı değiştirmeden önce yedekleyin.
GOOGLE_TOKEN_ENC_KEY=

# --- OneDrive dosya depolama (Google Drive'a alternatif) ---
# 1) portal.azure.com > Microsoft Entra ID > App registrations > New registration
#    "Supported account types" > "Accounts in any organizational directory and
#    personal Microsoft accounts" seçin (hem iş/okul hem kişisel hesaplar).
# 2) Authentication > Add a platform > Web > Redirect URI olarak aşağıdaki
#    MICROSOFT_REDIRECT_URI'yi ekleyin. "ID tokens" kutusunu işaretleyin.
# 3) Certificates & secrets > New client secret ile MICROSOFT_CLIENT_SECRET'ı üretin.
# 4) API permissions > Microsoft Graph > Delegated > Files.ReadWrite.AppFolder,
#    openid, email, profile, offline_access ekleyin.
# Kullandığımız Files.ReadWrite.AppFolder scope'u uygulamayı kendi özel
# klasörüyle sınırlar (Google'daki drive.file ile aynı fikir).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft'un geri döneceği adres. Azure App registration'daki değerle BİREBİR aynı olmalı.
# Yerel: http://localhost:3000/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Refresh token'ların şifrelenmesinde kullanılır (AES-256-GCM) — GOOGLE_TOKEN_ENC_KEY'den
# BİLEREK ayrı bir anahtar. Üretin: openssl rand -base64 32
MICROSOFT_TOKEN_ENC_KEY=
