PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/projelio
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=  # `node -e "console.log(require('web-push').generateVAPIDKeys())"` ile üretin
VAPID_PRIVATE_KEY=
SUPABASE_URL=https://kjglfieqodfwkkfzrrtq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Supabase Dashboard > Project Settings > API'den alın (gizli tutun)
S3_BUCKET=
# AI asistanı (chatbot) için gerekli — console.anthropic.com üzerinden alın
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Projelio AI kredi ekonomisi ---
# Projelio, Anthropic'ten token maliyetiyle hizmet alır ve kullanıcıya komisyon
# ekleyerek "Projelio Kredisi" olarak satar.
AI_COMMISSION_RATE=0.2          # 0.2 = %20 komisyon
AI_CREDIT_UNIT_USD=0.0001       # 1 kredinin USD karşılığı => 10.000 kredi ≈ 1 USD
AI_MIN_BALANCE_TO_START=20      # Yeni istek için gereken asgari bakiye
AI_WELCOME_CREDITS=2000         # Yeni kullanıcıya bir defalık deneme kredisi (0 = kapalı)

# --- Maliyet sınırlayıcıları (her biri doğrudan token harcamasını etkiler) ---
AI_PROMPT_CACHING=true          # Araç şemaları + statik promptu önbelleğe al (%90 ucuz okuma)
AI_MAX_TOKENS=800               # Tek yanıtta üretilebilecek azami token
AI_MAX_TOOL_ITERATIONS=4        # Bir istekteki azami araç turu (her tur = 1 API çağrısı)
AI_MAX_TOOL_RESULT_CHARS=2500   # Araç sonuçlarının azami uzunluğu
AI_HISTORY_WINDOW=8             # Modele geri beslenen geçmiş mesaj sayısı

# Anthropic fiyat değiştirirse kod değiştirmeden güncellemek için (opsiyonel):
# AI_PRICE_OVERRIDE={"claude-haiku-4-5-20251001":{"inputPerMillion":1,"outputPerMillion":5}}
