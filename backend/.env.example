PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/projelio
# Oturum jetonlarını imzalar. Bu değer sızarsa herkes istediği kullanıcı adına
# geçerli token üretebilir — parola bile gerekmez. Örnek/kısa değer bırakılırsa
# uygulama AÇILMAZ (bkz. backend/src/common/config/env.ts).
# Üretin:  openssl rand -base64 32
JWT_SECRET=
# Üretimde frontend'in alan adı(ları), virgülle ayrılmış. NODE_ENV=production iken
# boş bırakılırsa uygulama AÇILMAZ — eskiden bu durumda API tüm kaynaklara
# açılıyordu. Yerel geliştirmede boş bırakılabilir.
# Örn: CORS_ORIGINS=https://projelio.netlify.app
CORS_ORIGINS=
JWT_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=  # `node -e "console.log(require('web-push').generateVAPIDKeys())"` ile üretin
VAPID_PRIVATE_KEY=
SUPABASE_URL=https://kjglfieqodfwkkfzrrtq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=  # Supabase Dashboard > Project Settings > API'den alın (gizli tutun)

# Tarayıcıya verilecek GENEL storage adresi. Yalnızca SUPABASE_URL bir İÇ AĞ
# adresiyken gerekir (kendi sunucumuzda: http://caddy). Boş bırakılırsa kapak
# ve avatar bağlantıları SUPABASE_URL'den üretilir — Supabase barındırmalı
# kurulumda doğru olan budur, o yüzden orada tanımsız kalır.
# Bkz. SupabaseService.publicStorageUrl
PUBLIC_STORAGE_URL=
S3_BUCKET=
# AI asistanı (chatbot) için gerekli — console.anthropic.com üzerinden alın
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- AI sağlayıcıları (Lio çok sağlayıcılı) ---
# AI_PROVIDERS hem AÇAR hem SIRALAR: soldan sağa öncelikli, virgülle ayrılır.
# Tanımsızsa yalnızca Anthropic çalışır (aşağıdaki anahtarlar dolu olsa bile).
#   AI_PROVIDERS=anthropic          # varsayılan
#   AI_PROVIDERS=anthropic,zai      # önce Anthropic, düşerse z.ai
#   AI_PROVIDERS=zai,anthropic      # önce ucuz olan, yedek Anthropic
AI_PROVIDERS=anthropic

# z.ai (GLM) — z.ai/model-api üzerinden alınır. GLM 5.3 Flash çok ucuz.
ZAI_API_KEY=
# MiniMax — platform.minimax.io üzerinden alınır. Anthropic uyumlu uç kullanılır.
MINIMAX_API_KEY=

# Bir kademenin modelini ezmek için (opsiyonel): AI_MODEL_<SAĞLAYICI>_<KADEME>
# AI_MODEL_ZAI_SMART=glm-4.7
# AI_MODEL_MINIMAX_MAX=MiniMax-M3

# ⚠️ z.ai ve MiniMax Çin merkezlidir; açtığında müşteri verisi (görev içerikleri,
# dosya adları, WhatsApp mesajları) oraya gider. KVKK açısından bilinçli karar ver.

# --- Projelio AI kredi ekonomisi ---
# Projelio, Anthropic'ten token maliyetiyle hizmet alır ve kullanıcıya komisyon
# ekleyerek "Projelio Kredisi" olarak satar.
AI_COMMISSION_RATE=0.2          # 0.2 = %20 komisyon
AI_CREDIT_UNIT_USD=0.0001       # 1 kredinin USD karşılığı => 10.000 kredi ≈ 1 USD
AI_MIN_BALANCE_TO_START=20      # Yeni istek için gereken asgari bakiye
AI_WELCOME_CREDITS=2000         # Yeni kullanıcıya bir defalık deneme kredisi (0 = kapalı)

# --- Maliyet sınırlayıcıları (her biri doğrudan token harcamasını etkiler) ---
AI_PROMPT_CACHING=true          # Araç şemaları + statik promptu önbelleğe al (%90 ucuz okuma)
AI_MAX_TOKENS=800               # Tek yanıtta üretilebilecek azami token
AI_MAX_TOOL_ITERATIONS=4        # Bir istekteki azami araç turu (her tur = 1 API çağrısı)
AI_MAX_TOOL_RESULT_CHARS=2500   # Araç sonuçlarının azami uzunluğu
AI_HISTORY_WINDOW=8             # Modele geri beslenen geçmiş mesaj sayısı

# Anthropic fiyat değiştirirse kod değiştirmeden güncellemek için (opsiyonel):
# AI_PRICE_OVERRIDE={"claude-haiku-4-5-20251001":{"inputPerMillion":1,"outputPerMillion":5}}

# --- E-posta gönderimi (şifre sıfırlama) ---
# resend.com > API Keys üzerinden alın. Tanımlı değilse e-posta gönderilmez;
# sıfırlama bağlantısı yalnızca sunucu loguna yazılır (yerel geliştirme için yeterli).
RESEND_API_KEY=
# Gönderen adresi. Alan adı Resend'de doğrulanmış olmalı, aksi halde gönderim reddedilir.
# Doğrulama yapılmadan denemek için Resend'in test adresi kullanılabilir:
#   EMAIL_FROM=Projelio <onboarding@resend.dev>   (yalnızca kendi hesabınızın e-postasına gönderir)
EMAIL_FROM=Projelio <destek@projelio.app>

# --- Google ile giriş + Google Drive dosya depolama ---
# 1) console.cloud.google.com > yeni proje > "Google Drive API" ve "Google Picker API"yi etkinleştirin
# 2) APIs & Services > Credentials > OAuth client ID > Web application
#    Authorized redirect URI olarak aşağıdaki GOOGLE_REDIRECT_URI'yi ekleyin
# 3) OAuth consent screen > yayın durumunu "In production" yapın.
#    "Testing" modunda Google refresh token'ları 7 GÜN sonra iptal eder ve
#    kullanıcılar her hafta yeniden bağlanmak zorunda kalır.
#    Kullandığımız drive.file scope'u "non-sensitive" olduğu için CASA güvenlik
#    denetimi gerekmez; yalnızca marka doğrulaması istenir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google'ın geri döneceği adres. Google Cloud Console'daki değerle BİREBİR aynı olmalı.
# Yerel: http://localhost:3000/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# OAuth akışı bitince kullanıcının döneceği ön yüz adresi (Vite dev sunucusu / Netlify).
WEB_APP_URL=http://localhost:5173

# Refresh token'ların şifrelenmesinde kullanılır (AES-256-GCM).
# Üretin:  openssl rand -base64 32
# Bu anahtar kaybolursa tüm kullanıcıların Drive bağlantısı kopar ve yeniden
# bağlanmaları gerekir. Anahtarı değiştirmeden önce yedekleyin.
GOOGLE_TOKEN_ENC_KEY=

# --- OneDrive dosya depolama (Google Drive'a alternatif) ---
# 1) portal.azure.com > Microsoft Entra ID > App registrations > New registration
#    "Supported account types" > "Accounts in any organizational directory and
#    personal Microsoft accounts" seçin (hem iş/okul hem kişisel hesaplar).
# 2) Authentication > Add a platform > Web > Redirect URI olarak aşağıdaki
#    MICROSOFT_REDIRECT_URI'yi ekleyin. "ID tokens" kutusunu işaretleyin.
# 3) Certificates & secrets > New client secret ile MICROSOFT_CLIENT_SECRET'ı üretin.
# 4) API permissions > Microsoft Graph > Delegated > Files.ReadWrite.AppFolder,
#    openid, email, profile, offline_access ekleyin.
# Kullandığımız Files.ReadWrite.AppFolder scope'u uygulamayı kendi özel
# klasörüyle sınırlar (Google'daki drive.file ile aynı fikir).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Microsoft'un geri döneceği adres. Azure App registration'daki değerle BİREBİR aynı olmalı.
# Yerel: http://localhost:3000/auth/microsoft/callback
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Refresh token'ların şifrelenmesinde kullanılır (AES-256-GCM) — GOOGLE_TOKEN_ENC_KEY'den
# BİLEREK ayrı bir anahtar. Üretin: openssl rand -base64 32
MICROSOFT_TOKEN_ENC_KEY=

# --- Instagram'a doğrudan yayın (Sosyal Medya modülü) ---
# Kurulumun tamamı: docs/moduller/14-instagram-entegrasyonu.md
# 1) developers.facebook.com > Uygulama oluştur > "Instagram" ürününü ekleyin.
# 2) "API setup with Instagram login" bölümünden Instagram App ID / Secret alın.
# 3) OAuth Redirect URI olarak aşağıdaki INSTAGRAM_REDIRECT_URI'yi BİREBİR ekleyin.
# 4) İzinler: instagram_business_basic, instagram_business_content_publish
#    (ikisi de App Review ister; geliştirme modunda yalnızca uygulamada rolü
#    olan test hesaplarıyla çalışır).
# Bağlanacak hesap Instagram'da PROFESYONEL (işletme/içerik üretici) olmalı.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta'nın geri döneceği adres. Meta panelindeki değerle BİREBİR aynı olmalı.
# Yerel: http://localhost:3000/social/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/social/instagram/callback

# Sosyal medya erişim jetonlarının şifrelenmesi (AES-256-GCM) — Google ve
# Microsoft anahtarlarından BİLEREK ayrı. Üretin: openssl rand -base64 32
# Anahtar yoksa entegrasyon kapalı kabul edilir, arayüzde düğme çıkmaz.
SOCIAL_TOKEN_ENC_KEY=

# Sosyal medya HESAP ŞİFRELERİNİN şifrelenmesi (AES-256-GCM). Jeton
# anahtarından BİLEREK ayrı: biri sızarsa diğeri etkilenmesin, ayrı ayrı
# döndürülebilsin. Üretin: openssl rand -base64 32
# Anahtar yoksa şifre kaydedilemez — düz metin yazmak yerine hata döner.
SOCIAL_CREDENTIAL_ENC_KEY=

# --- E-posta modülü: Outlook gelen kutusu ---
# Kurulumun tamamı: docs/moduller/15-eposta-gelen-kutusu.md
# Yeni bir Azure uygulaması GEREKMEZ: OneDrive için kullandığınız uygulamaya
# iki izin ve bir redirect URI eklenir.
#   1) Azure Portal > App registrations > (mevcut uygulama) > API permissions >
#      Microsoft Graph > Delegated > Mail.ReadWrite ve Mail.Send ekleyin.
#   2) Authentication > Redirect URIs > aşağıdaki adresi ekleyin.
# Posta akışı depolamadan AYRI bir adres kullanır; ikisi de kayıtlı olmalı.
# Yerel: http://localhost:3000/mail/microsoft/callback
MICROSOFT_MAIL_REDIRECT_URI=http://localhost:3000/mail/microsoft/callback

# --- Habie mesajlaşma modülü ---
# Habie tarafındaki APP_SECRETS içindeki "projelio" değeriyle BİREBİR aynı olmalı.
HABIE_APP_SECRET=

# --- Herkese açık demo hesabı (ceo@celikhan.test) ---
# Demo verisi her girişte database/demo/celikhan-demo.json'dan geri yükleniyor
# (bkz. backend/src/modules/demo/demo-sifirlama.service.ts).
#
# Demoyu elle düzenlemenin NORMAL yolu admin panelindeki "düzenleme kipi"dir
# (Admin paneli > Demo hesabı): açarsın, düzenlersin, kapatınca o hâl kaydedilir.
# Aşağıdaki değişken yalnızca ACİL FREN: panele erişilemediğinde sıfırlamayı
# tamamen durdurur. Açık kalırsa ziyaretçilerin bıraktığı hiçbir şey temizlenmez.
DEMO_SIFIRLAMA_KAPALI=0

# Demo hesabında Lio ücretsiz ama sınırsız değil: tüm ziyaretçilerin ortak
# saatlik tavanı (kredi). 8000 kredi ≈ saatte 15-20 Lio turu, ~0,7 USD maliyet.
AI_DEMO_SAATLIK_KREDI=8000

# --- WhatsApp köprüsü (WAHA) ---
# Tasarım: docs/whatsapp-qr-plan.md. Yerelde denemek için WAHA'yı ayrıca
# ayağa kaldırın:  docker run -p 3000:3000 -e WAHA_API_KEY=... devlikeapro/waha
# Dördü de tanımlı değilse köprü kapalı kabul edilir, arayüzde
# "yapılandırılmamış" görünür, hiçbir cron çalışmaz.
WAHA_URL=
WAHA_API_KEY=
# WAHA → backend webhook imzası (HMAC). Üretin: openssl rand -hex 32
WAHA_WEBHOOK_HMAC=
# WAHA'nın backend'e ULAŞABİLECEĞİ adres (yerelde docker'dan host'a:
# http://host.docker.internal:3000/whatsapp/webhook).
WHATSAPP_WEBHOOK_URL=
# İsteğe bağlı hız sınırı ayarları (varsayılanlar whatsapp-rate-limit.ts'te):
# WHATSAPP_RATE_PER_MINUTE=8  WHATSAPP_RATE_PER_HOUR=200  WHATSAPP_RATE_PER_DAY=1500
# WHATSAPP_WARMUP_DAY_ONE=20  WHATSAPP_WARMUP_DAYS=7  WHATSAPP_RATE_PER_CONTACT_PER_DAY=20
# WHATSAPP_QUIET_START=22  WHATSAPP_QUIET_END=8
