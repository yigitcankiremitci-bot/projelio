# Projelio production environment — example.
#
# Copy this to .env on the server (/srv/projelio/deploy/.env), fill in real
# values, then lock it down:
#
#   chown projelio:projelio .env && chmod 600 .env
#
# Never commit the real .env. Generate the password with:
#
#   openssl rand -base64 32 | tr -d '\n/+=' | head -c 40
#
# The '/+=' characters are stripped so the value can be dropped into a
# connection string without percent-encoding.

# --- Postgres (stage B) -----------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Canlı Supabase dump bağlantısı. Projelio projesi eu-central-1 bölgesinde.
SUPABASE_DB_POOLER_REGION=eu-central-1

# --- Servis ve uygulama JWT'leri -------------------------------------------
# Storage ile PostgREST'in ortak HMAC sırrı. Kullanıcı oturumlarını imzalayan
# APP_JWT_SECRET'tan ayrı tutulur.
#
#   openssl rand -hex 32
SUPABASE_JWT_SECRET=

# Projelio kullanıcı oturumları ve parola sıfırlama jetonları.
APP_JWT_SECRET=

# {"role":"service_role"} taşıyan, SUPABASE_JWT_SECRET ile imzalı JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Login password for supabase_storage_admin, the role that owns and migrates
# the storage schema. Created by hand (stage C), not by the container.
#
#   openssl rand -hex 24
STORAGE_DB_PASSWORD=

# PostgREST'in bağlandığı authenticator rolünün parolası.
AUTHENTICATOR_DB_PASSWORD=

# --- İsteğe bağlı web entegrasyonları --------------------------------------
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=
VITE_HABIE_URL=

# --- Alan adları ve Google OAuth -------------------------------------------
NEXT_PUBLIC_SITE_URL=https://projelio.app
NEXT_PUBLIC_APP_URL=https://app.projelio.app

# Google Cloud Console Authorized redirect URI:
# https://api.projelio.app/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.projelio.app/auth/google/callback
BACKEND_URL=https://api.projelio.app
WEB_APP_URL=https://app.projelio.app

# Google Drive bağlantısı da kullanılacaksa 32-byte anahtar gerekir.
# Üretimden sonra değiştirmek kayıtlı refresh token'ları okunamaz hâle getirir.
GOOGLE_TOKEN_ENC_KEY=

# --- Landing ---------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP=
RESEND_API_KEY=
CONTACT_TO=info@projelio.app
CONTACT_FROM=Projelio <onboarding@resend.dev>

# ===========================================================================
# UYGULAMA SIRLARI — göç anında Render panelinden BURAYA taşınacak
# ===========================================================================
#
# Yukarıdaki bölümler altyapıyı ayağa kaldırır; aşağıdakiler uygulamanın
# ÇALIŞMASI için gerekli. Eksik olduklarında backend açılır ama Google Drive,
# OneDrive, Instagram, Lio ve push bildirimleri sessizce çalışmaz — bu yüzden
# "sunucu ayakta" ile "göç tamam" aynı şey değil.
#
# Kaynak: render.yaml'daki `sync: false` işaretli değerler, Render panelinin
# Environment sekmesinden okunur. Tam açıklamaları backend/.env.example'da.
#
# ŞİFRELEME ANAHTARLARINI YENİDEN ÜRETMEYİN — AYNEN KOPYALAYIN.
# GOOGLE_TOKEN_ENC_KEY, MICROSOFT_TOKEN_ENC_KEY, SOCIAL_TOKEN_ENC_KEY ve
# SOCIAL_CREDENTIAL_ENC_KEY, veritabanındaki şifreli satırları çözen
# anahtarlardır. Yeni anahtar üretilirse veri kopyalanmış ama ÇÖZÜLEMEZ olur:
# bütün Drive/OneDrive/Instagram bağlantıları kopar, kayıtlı hesap şifreleri
# okunamaz hâle gelir. Geri dönüşü yoktur.

# --- Oturum ---------------------------------------------------------------
# DİKKAT: APP_JWT_SECRET Render'daki JWT_SECRET'tan FARKLIYSA geçiş anında
# herkesin oturumu düşer (elde açık token kalmaz, herkes yeniden giriş yapar).
# Kesintisiz geçiş isteniyorsa Render'daki değerin AYNISI kullanılmalı.
JWT_EXPIRES_IN=7d

# --- Adresler --------------------------------------------------------------
# CORS_ORIGINS, WEB_APP_URL ve PUBLIC_STORAGE_URL compose dosyasında sabit
# (app.projelio.app / api.projelio.app); burada tekrarlanmıyor.

# --- Lio (AI asistan) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Lio'ya iliştirilen ses dosyalarını yazıya çevirmek için (Anthropic ses almaz).
OPENAI_API_KEY=
AI_COMMISSION_RATE=0.2
AI_CREDIT_UNIT_USD=0.0001
AI_MIN_BALANCE_TO_START=20
AI_WELCOME_CREDITS=2000
AI_PROMPT_CACHING=true

# --- Push bildirimleri -----------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Google ile giriş + Drive ----------------------------------------------
# GOOGLE_REDIRECT_URI yeni API alan adına göre değişir ve aynı değer Google
# Cloud Console'daki uygulama kaydına da eklenmeli — yoksa giriş "redirect_uri
# mismatch" ile durur. Eski Render adresi geri dönüş penceresi boyunca kayıtlı
# KALSIN; ikisi bir arada durabilir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# KOPYALA, üretme.
GOOGLE_TOKEN_ENC_KEY=

# --- OneDrive + Outlook ----------------------------------------------------
# İki ayrı redirect URI: depolama ve posta. İkisi de Azure uygulama kaydına
# eklenmeli (bkz. docs/moduller/15-eposta-gelen-kutusu.md).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_MAIL_REDIRECT_URI=
# KOPYALA, üretme.
MICROSOFT_TOKEN_ENC_KEY=

# --- Instagram'a doğrudan yayın --------------------------------------------
# Redirect URI Meta panelindeki değerle birebir aynı olmalı.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# KOPYALA, üretme.
SOCIAL_TOKEN_ENC_KEY=

# Sosyal hesap giriş şifreleri (bkz. 076_sosyal_hesap_kimlik_bilgileri.sql).
# Render'da tanımlı DEĞİL — bu özellik VPS'e geçişle birlikte geliyor, yani
# burada yeni üretilecek tek anahtar bu:  openssl rand -base64 32
SOCIAL_CREDENTIAL_ENC_KEY=

# --- WhatsApp köprüsü (WAHA) -----------------------------------------------
# Hepsini deploy/whatsapp-kur.sh üretir ve .env'e ekler; elle doldurma.
# Backend → WAHA kimliği. Üret: openssl rand -hex 32
WAHA_API_KEY=
# WAHA → backend webhook imzası. Üret: openssl rand -hex 32
WAHA_WEBHOOK_HMAC=
# Postgres "waha" rolünün şifresi (oturum anahtarları burada saklanır).
# Bağlantı dizesine giriyor: '/+=' içermesin.
WAHA_DB_PASSWORD=

# --- Habie mesajlaşma ------------------------------------------------------
# Habie tarafındaki APP_SECRETS içindeki "projelio" değeriyle AYNI olmalı.
HABIE_APP_SECRET=

# --- Demo hesabı -----------------------------------------------------------
# Herkese açık demo her girişte sıfırlanır; kapatmak için 1 yapın.
DEMO_SIFIRLAMA_KAPALI=0
AI_DEMO_SAATLIK_KREDI=
