[Unit]
Description=Projelio başarılı main commitini canlıya al
After=docker.service network-online.target
Wants=network-online.target
# Dağıtım düşerse haber ver. Bu satır olmadan hata yalnızca journal'a yazılıyor
# ve zamanlayıcı her dakika sessizce yeniden deniyordu (2026-09-03'te yaşandı).
OnFailure=projelio-uyari@%n.service

[Service]
Type=oneshot
ExecStart=/srv/projelio/deploy/cicd-deploy.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
