[Unit]
Description=Projelio günlük yedek (veritabanı + yüklenen dosyalar)
After=docker.service
Requires=docker.service
# Yedek düşerse (ya da dış kopya gönderilemezse — betik o hâlde 2 ile çıkar)
# haber ver. "Yedeğim var" sanıp yedeksiz kalmak, bu listedeki en pahalı hata.
OnFailure=projelio-uyari@%n.service

[Service]
Type=oneshot
ExecStart=/srv/projelio/deploy/yedekle.sh
# Yedek, canlı trafiğin önüne geçmesin: düşük öncelikli çalışır.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
