# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# Vercel'de aynı anahtarları Project Settings → Environment Variables altına girin.

# Yayındaki alan adınız (sonunda / olmadan)
NEXT_PUBLIC_SITE_URL=https://projelio.app

# Uygulama/panel adresi. Henüz yayında değilse iletişim sayfanızı yazabilirsiniz.
NEXT_PUBLIC_APP_URL=https://projelio.netlify.app

# WhatsApp numarası — uluslararası format, sadece rakam. Örn: 905551112233
NEXT_PUBLIC_WHATSAPP=

# İletişim formunun e-posta göndermesi için (resend.com üzerinden ücretsiz alınır)
RESEND_API_KEY=
CONTACT_TO=info@projelio.app
# Alan adınızı Resend'de doğruladıktan sonra: Projelio <merhaba@projelio.app>
CONTACT_FROM=Projelio <onboarding@resend.dev>
